{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "skipLibCheck": true,
    "lib": [
      "ES2022",
      "DOM"
    ],
    "types": [
      "vite/client",
      "node"
    ]
  },
  "include": [
    "src",
    "dev",
    "test",
    "e2e",
    "playwright.config.ts",
    "vite.config.ts"
  ],
  "exclude": [
    "test/worker.test.ts",
    "test/cuenta.test.ts",
    "test/admin.test.ts",
    "test/documentos.test.ts",
    "test/ia.test.ts"
  ]
}
